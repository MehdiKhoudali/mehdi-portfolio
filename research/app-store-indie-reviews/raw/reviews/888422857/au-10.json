{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id86337733"}, "name":{"label":"Botowski"}, "label":""}, "updated":{"label":"2021-12-07T20:17:12-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"2021.11"}, "id":{"label":"8106768763"}, "title":{"label":"Data loss"}, "content":{"label":"Overcast is my most used app. I recently upgraded iPhones and learned that it doesn’t transfer podcasts episodes, rather it downloads them from original sources. Unfortunately many of them are no longer available, meaning I’ve lost several hundred episodes of podcasts (old and new ones). Changing podcasts apps after this.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
