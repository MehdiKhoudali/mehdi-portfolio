{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id30225164"}, "name":{"label":"TimBUK2-2"}, "label":""}, "updated":{"label":"2025-11-12T04:25:49-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2025.11"}, "id":{"label":"13388483044"}, "title":{"label":"My go to podcast app"}, "content":{"label":"I’ve been using Overcast for a number of years, it allows me to group podcasts to gather, decide how many episodes I want to download but best of all. Individual speed (I use 1.2 for anything not related to music) and smart skipping that takes out empty time.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
