{"author":{"uri":{"label":"https://itunes.apple.com/nz/reviews/id107816537"}, "name":{"label":"DuncanWNZ"}, "label":""}, "updated":{"label":"2020-09-23T20:51:12-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2020.6"}, "id":{"label":"6462179936"}, "title":{"label":"Simple, unobtrusive and good"}, "content":{"label":"I moved to Overcast in preference to Spotify and Apple podcast app to get a simpler interface that didn’t push episodes I don’t want, doesn’t “modify” my settings preferences periodically etc, and yet still does everything I want.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/nz/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/nz/reviews/id21955989"}, "name":{"label":"Spaztian"}, "label":""}, "updated":{"label":"2020-09-21T19:46:38-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2020.6"}, "id":{"label":"6454770724"}, "title":{"label":"Apple should have hired these guys to fix their Podcast app"}, "content":{"label":"It is no secret that the Apple Podcasts app is a mess of unfriendly UI design and function. Overcast makes up for Apple’s failure by providing the most simple and elegant podcast solution without the absence of extra bells and whistles. Having tried a few podcast apps I can’t look past Overcast for all my Podcasting needs.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/nz/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
