{"author":{"uri":{"label":"https://itunes.apple.com/nz/reviews/id24875380"}, "name":{"label":"aimee.heath"}, "label":""}, "updated":{"label":"2025-11-26T23:21:19-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2025.11.1"}, "id":{"label":"13445933047"}, "title":{"label":"Genuinely Thoughtful"}, "content":{"label":"I’ve used Overcast for years and have never had a bad experience. I love Voice Boost, and the ability to auto skip intros and outros. The new filter for promos is so useful, I was previously unsubscribing from podcasts which spammed my feed with awful podcast recommendations. One of my absolute must have apps.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/nz/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
