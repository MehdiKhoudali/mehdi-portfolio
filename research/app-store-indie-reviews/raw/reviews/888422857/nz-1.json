{"author":{"uri":{"label":"https://itunes.apple.com/nz/reviews/id86115923"}, "name":{"label":"inexplicablysane"}, "label":""}, "updated":{"label":"2026-04-19T13:04:32-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2026.4"}, "id":{"label":"13975936765"}, "title":{"label":"Listen how I want"}, "content":{"label":"Overtime lets me choose how I listen to podcasts, how I group and filter them - instead of forcing me to follow someone else’s idea of how I should listen as so many other apps do. \n\nThe transcription feature absolutely rocks, game changer for navigation but absolutely transformative for absorbing the ideas and stories from the people I’m listening to. \n\nNever stop never stopping Overcast.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/nz/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
