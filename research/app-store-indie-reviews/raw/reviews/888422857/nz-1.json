{"author":{"uri":{"label":"https://itunes.apple.com/nz/reviews/id276706276"}, "name":{"label":"Juno star1"}, "label":""}, "updated":{"label":"2025-11-22T23:54:45-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2025.11.1"}, "id":{"label":"13430785332"}, "title":{"label":"Give it a try!"}, "content":{"label":"I’ve been using Overcast for more than five years. It’s easy to use- the upgrade tweaks steadily improve it with good new features. They respect the users (unlike, say, A**le or Mic**so**) It is great to be supporting a small company outside the social media/silicon valley nutcases currently interfering in global govt efforts to give us back control.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/nz/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
