{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1160009040"}, "name":{"label":"West LA Greenie"}, "label":""}, "updated":{"label":"2025-11-25T08:17:27-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"2025.11.1"}, "id":{"label":"13439851138"}, "title":{"label":"Broken for the past 2 weeks"}, "content":{"label":"The app is broken most of the time it just gives me a \"syncing\" progress bar that almost never clears. when it does occasionally clear, the app has very limited functionality and has completely forgotten my podcasts and history. \n\nI tried uninstalling the app and reinstalling, but this is still happening.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
