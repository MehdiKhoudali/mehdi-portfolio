{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id641382075"}, "name":{"label":"RRC7112"}, "label":""}, "updated":{"label":"2025-11-25T10:45:01-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"2025.11.1"}, "id":{"label":"13440317942"}, "title":{"label":"App Non-functional after update"}, "content":{"label":"After the 2025-11-21 update, Overcast simply will not launch. It briefly flashes a loading circle, then the app closes a few milliseconds later. It does not appear in the app switcher after closing itself, so I assume it is full on crashing. Restarting phone, reinstalling app does not fix the behavior.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
