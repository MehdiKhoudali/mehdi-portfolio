{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id143634262"}, "name":{"label":"Niaow"}, "label":""}, "updated":{"label":"2025-11-26T17:42:35-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"2025.11.1"}, "id":{"label":"13445194575"}, "title":{"label":"Both simple and complete"}, "content":{"label":"There is little to say about Overcast, it is both simpler than other podcast apps I have tried (including Apple Podcasts, which frankly is sub par) and nevertheless nearly full featured.\nThe basic operations are straightforward and it’s easy to configure and adapt to your listening flows.\nIt would be perfect if it had a mechanism for catching up to old episodes alongside new ones but no other apps support that so it still stands at the top even without it.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
