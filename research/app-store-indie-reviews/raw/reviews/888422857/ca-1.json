{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id139259769"}, "name":{"label":"Jendhansen"}, "label":""}, "updated":{"label":"2025-12-16T21:57:14-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2025.12"}, "id":{"label":"13522706066"}, "title":{"label":"Perfect"}, "content":{"label":"I’ve been using overcast for daily podcast listening for years and find it preferable to any other app I’ve tried. I love sorting it so that it displays only shows with unplayed episodes. If I’m all caught up, it doesn’t show in my feed until a new episode drops. It’s very satisfying to see my list grow shorter as I work through new episodes each week and I don’t have to click on every show I follow to see if anything is new.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
