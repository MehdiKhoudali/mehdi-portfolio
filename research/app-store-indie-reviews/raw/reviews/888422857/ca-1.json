{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id382502479"}, "name":{"label":"Booknerdproblems"}, "label":""}, "updated":{"label":"2026-06-10T11:45:03-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"2026.5"}, "id":{"label":"14167096462"}, "title":{"label":"June 2026 Update Terrible"}, "content":{"label":"I have loved this app for years. However, with the newest update I keep having my episodes stop part way through and then when I try to play them again it’s as if I never listened at all and I have to start over. It’s driving me nuts. They’re downloaded episodes. Why are they dropping?", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
