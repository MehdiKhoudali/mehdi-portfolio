{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id201024206"}, "name":{"label":"Stanley Omar"}, "label":""}, "updated":{"label":"2024-07-25T18:56:44-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"2024.7.2"}, "id":{"label":"11535360728"}, "title":{"label":"Why change the sleep timer?"}, "content":{"label":"Having the sleep timer right up front, along with it saving the previously-used timer length, was the best thing about the play screen apart the 30 second skip buttons. I used that timer button almost every day. Why change its functionality a bury it under two additional clicks?", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
