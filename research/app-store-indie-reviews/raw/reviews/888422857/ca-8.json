{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id124695194"}, "name":{"label":"Zeph211"}, "label":""}, "updated":{"label":"2024-07-25T05:43:17-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"2024.7.2"}, "id":{"label":"11533168842"}, "title":{"label":"New Update Resets Download Settings"}, "content":{"label":"The new update resets your download settings and downloads EVERYTHING. My device is now full and there is no way to mass delete the files. I have to go in and manually delete them. This update ended up wasting a bunch of my time.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
