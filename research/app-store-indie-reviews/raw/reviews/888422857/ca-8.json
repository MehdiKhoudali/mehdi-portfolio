{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id599416635"}, "name":{"label":"MarieEve111"}, "label":""}, "updated":{"label":"2024-07-24T05:46:27-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2024.7.2"}, "id":{"label":"11529333486"}, "title":{"label":"Best Podcast App by Far!"}, "content":{"label":"I usually never write reviews, but I'm so impressed with this app that I felt compelled to share my thoughts. This is by far the best podcast app I've ever used. The latest updates have brought fantastic improvements, making it even more enjoyable.\n\nI really love the customizable playback speed option, tailored to each podcast, which adds a whole new level of convenience. The interface is now simpler and more intuitive than ever. \nKudos to the creator for an outstanding job!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
