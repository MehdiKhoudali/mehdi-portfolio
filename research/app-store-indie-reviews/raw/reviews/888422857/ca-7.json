{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id29752186"}, "name":{"label":"Mark from Vancouver, BC"}, "label":""}, "updated":{"label":"2024-08-05T14:38:00-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2024.8"}, "id":{"label":"11576470753"}, "title":{"label":"Great app!"}, "content":{"label":"This is the best way to handle podcasts. With the Sonos app update a hot mess, Overcast is essential for Sonos. It’s easy to use, efficient, and attractive. 5 stars, without hesitation or doubt!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
