{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id105904500"}, "name":{"label":"Ecce Phono"}, "label":""}, "updated":{"label":"2024-08-03T02:21:29-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2024.8"}, "id":{"label":"11566767602"}, "title":{"label":"Rewrite Gold"}, "content":{"label":"I absolutely love the new design, especially the in-line progress feed-back and seek regret affordance. Everything feels clean, fresh, and instantly responsive. I was only bitten by two bugs quickly fixed thanks to Marco’s long established diligence. I thought the old app was great, but this feels like a new app (still clearly Overcastish) and is better than ever.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
