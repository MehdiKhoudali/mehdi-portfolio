{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id87570975"}, "name":{"label":"gogogomer"}, "label":""}, "updated":{"label":"2026-05-07T09:07:26-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2026.4.1"}, "id":{"label":"14038518068"}, "title":{"label":"Transcriptions!"}, "content":{"label":"Several of my favorite podcasts include guests with strong accents that can make their English difficult to understand. Transcriptions solves this for me. I know Apple deserves some of the credit here but I also know that Overcast’s developer put a significant amount of time and money into making transcripts available. What seems particularly wasteful is that the transcribing work is duplicated by both Apple & Overcast. I wish Apple would put competition aside and consider the environmental impact this one issue has. Thank you.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
