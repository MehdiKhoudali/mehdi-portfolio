{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id11055311"}, "name":{"label":"MickyE84"}, "label":""}, "updated":{"label":"2025-11-22T21:00:41-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2025.11.1"}, "id":{"label":"13430400839"}, "title":{"label":"Clean design, performant and good features"}, "content":{"label":"This app that is full of features, with a straight forward and fast interface. \nFor me, the Apple Podcast app drives me insane with slow performance and animations everywhere wasting time, so Overcast is a breath of fresh air. I also like the Apple Watch support and downloads when I am exercising.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
