{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id150125501"}, "name":{"label":"SiberAngel"}, "label":""}, "updated":{"label":"2023-03-01T22:36:16-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2023.2"}, "id":{"label":"9670247044"}, "title":{"label":"Wish I’d Found This Sooner"}, "content":{"label":"I found this app because Apple Podcasts became so bad even I couldn’t stand to stay any longer. I wish I’d jumped sooner! This app is so easy, and it just works. I can set up a playlist on the fly. I can trim the beginning and end of my regular podcasts. There’s some trickery that cuts out empty space. This is so good I’ve subscribed to show my appreciation, and kept the ads on because they are helping me find new podcasts to listen to.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
