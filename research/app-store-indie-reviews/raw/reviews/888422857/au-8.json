{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id24792783"}, "name":{"label":"Jarrod Tunes"}, "label":""}, "updated":{"label":"2022-09-10T12:41:42-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2022.9"}, "id":{"label":"9071824119"}, "title":{"label":"Simple. The best."}, "content":{"label":"I’ve used Overcast for a couple of years now, and it remains my podcast/audio app of choice. It’s super easy to find new podcasts, either on the web or on the app. More importantly I really appreciate the ‘nit picky’ details and the options to alter seek back/forward times. Do yourself a favour and download this app.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
