{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id125941175"}, "name":{"label":"Thermidore"}, "label":""}, "updated":{"label":"2025-01-21T12:05:24-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"2024.11.2"}, "id":{"label":"12212961996"}, "title":{"label":"Great podcast app - bad redesign"}, "content":{"label":"I love this app, I've been using it for ages since moving from Apple Podcasts. Unfortunately, it's been recently redesigned and a bunch of frequent actions like moving the episode to be next in the queue or easily getting to the podcast from an episode got much harder to take. From my perspective, the buttons used didn't even get replaced with anything, they simply disappeared. I don't know what I can do about it, but would love for the redesign to be reversed", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
