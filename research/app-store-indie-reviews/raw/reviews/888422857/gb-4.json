{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id236124686"}, "name":{"label":"Dr  G"}, "label":""}, "updated":{"label":"2024-12-29T08:01:27-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2024.11.2"}, "id":{"label":"12120127566"}, "title":{"label":"Just great!"}, "content":{"label":"Excellent app for both iPhone and Apple Watch; I love the speed controls and speech enhancement features. Great to be able to select from a list of podcasts from the Apple Watch, then control \"remote\" playback on the IPhone. Recommended!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id18884556"}, "name":{"label":"Voronin"}, "label":""}, "updated":{"label":"2024-12-27T08:30:20-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"2024.11.2"}, "id":{"label":"12112277665"}, "title":{"label":"Sadly now unusable"}, "content":{"label":"There is a consistent pattern to recent reviews of this app.  Sadly this one has to concur.\n\nOvercast used to be the best podcast app available and I have been an avid user for many years.\nUnfortunately, the recent updates have made it  unusable.  \nIssues experienced range from it failing to keep the position during playbacks, issues with podcasts not downloading and then deleting them once downloaded, to the app being stuck on syncing each time it is opened.\n\nReluctantly switching to a new player.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id208458824"}, "name":{"label":"Steve :246"}, "label":""}, "updated":{"label":"2024-12-23T07:46:01-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"2024.11.2"}, "id":{"label":"12096898334"}, "title":{"label":"Once excellent, now unusable"}, "content":{"label":"Deletes items randomly from the queue and has done for several months. Such a pity because it was once a 5 star app which worked well", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
