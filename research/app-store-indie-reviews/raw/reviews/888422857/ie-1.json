{"author":{"uri":{"label":"https://itunes.apple.com/ie/reviews/id381638162"}, "name":{"label":"LaurCo23"}, "label":""}, "updated":{"label":"2026-09-08T07:50:17-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2026.8.1"}, "id":{"label":"14525560959"}, "title":{"label":"Anti-Spotify, Pro Overcast"}, "content":{"label":"I was looking for a more ethical alternative to Spotify and started using Overcast about a year ago. I absolutely love it! I do wish it was easier to discover new podcasts on the app, as I like getting recommendations (an “Editor’s Pick” or something similar would be amazing). But I’m satisfied with what it offers and appreciate the work that the developers have obviously put into it.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ie/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
