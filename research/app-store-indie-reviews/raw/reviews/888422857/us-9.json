{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id110429822"}, "name":{"label":"Bondi2Bronte"}, "label":""}, "updated":{"label":"2025-12-05T10:27:54-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"2025.12"}, "id":{"label":"13478743528"}, "title":{"label":"Very bad for podcast discovery"}, "content":{"label":"I moved to Overcast from the Apple podcast app about 24 months ago. I love the all the upgrades and improvements between the two (I’m sure other reviews will cover this). I’m in search for a new app now as the podcast search/discoverability experience has reached the tipping point of frustration, and so has a bug that’s not allowing me to send them feedback directly from the app.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
