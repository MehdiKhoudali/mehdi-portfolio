{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id32156311"}, "name":{"label":"wisecooksey"}, "label":""}, "updated":{"label":"2025-11-28T19:33:03-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2025.11.1"}, "id":{"label":"13453137400"}, "title":{"label":"Love the (new) features!"}, "content":{"label":"After a decade in the default purple Podcast app, I’ve been using Overcast almost exclusively for 4 or 5 yrs now. \n\nThe design is great too, but it’s the thoughtful out-of-the-box features just make it feel like I’m listening better somehow.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
