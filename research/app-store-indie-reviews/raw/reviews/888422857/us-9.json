{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id27799024"}, "name":{"label":"Trey Piepmeier"}, "label":""}, "updated":{"label":"2025-11-28T09:45:14-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2025.11.1"}, "id":{"label":"13451488530"}, "title":{"label":"The best."}, "content":{"label":"Just do yourself a favor and buy this. Get whatever add-on to give it all the bells and whistles. The volume boost and smart speed are great. \n\nI just got a new iPhone and was able to get back to exactly where I was with all my shows immediate thanks to the sync feature. Yeah, so that's great too. Buy it.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1073053245"}, "name":{"label":"Callista Sparks"}, "label":""}, "updated":{"label":"2025-11-28T08:52:38-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2025.11.1"}, "id":{"label":"13451309443"}, "title":{"label":"Still my top podcast app"}, "content":{"label":"Big redesign but overall for the better. I continue to use this app on a daily basis. I appreciate the care that the developer takes to play with the fiddly details and balance feedback with his vision. Adding lots of great features regularly.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
