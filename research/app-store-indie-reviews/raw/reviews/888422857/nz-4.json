{"author":{"uri":{"label":"https://itunes.apple.com/nz/reviews/id86262967"}, "name":{"label":"Dankaska"}, "label":""}, "updated":{"label":"2016-07-25T20:08:32-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2.5.7"}, "id":{"label":"1419991263"}, "title":{"label":"Solves all my podcast bugbears"}, "content":{"label":"This app is great, and fits my use case amazingly well.\nI can get a good listing of all my podcast episodes in date order, I can get it to auto-stop at the end of any episode no matter whether I have newer ones, and it cleans up automatically when I'm done with episodes.\nPlus, it has a cool feature that skips empty silence in podcasts for those presenters that overuse \"pause for emphasis\", and you can customise how far fast-forward and rewind go.\nDid I mention no ads?\nWell worth the time to switch! Thank you :)", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/nz/review?id=888422857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
