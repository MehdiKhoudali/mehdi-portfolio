{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id37113919"}, "name":{"label":"johnnyappleseed001"}, "label":""}, "updated":{"label":"2026-06-01T15:35:54-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"8.0.3"}, "id":{"label":"14132971633"}, "title":{"label":"Won’t sync with Apple steps"}, "content":{"label":"I walked with a real pedometer clipped to my waist while charging my iPhone on my desk and I added those steps to the iPhones Health app but they do not show up on the Pedometer++ app. \n\nJust to be clear those manually added steps do show up in the Health app Steps.  Also, just so you know, I do not use the Apple Watch to count steps;  I only use my iPhone or physical pedometer to count steps.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=712286167&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
