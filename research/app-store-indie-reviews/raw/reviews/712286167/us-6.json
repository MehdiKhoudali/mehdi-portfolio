{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id19093065"}, "name":{"label":"thezoostory"}, "label":""}, "updated":{"label":"2025-12-06T14:04:34-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"7.0.4"}, "id":{"label":"13483489071"}, "title":{"label":"Lost a bunch of steps"}, "content":{"label":"I was liking this app till all of a sudden I opened it and it robbed me of a ton of steps and past achievements. So frustrating and disheartening. It’s also very confusing with how it calculates steps from my phone. I’ve gone into the health app, changed the order of things etc. and nothing seems to work. Lost a lot of data. Boo.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=712286167&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
