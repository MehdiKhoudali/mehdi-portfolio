{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id217914494"}, "name":{"label":"Beard1234"}, "label":""}, "updated":{"label":"2025-06-29T16:40:39-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"6.2.6"}, "id":{"label":"12833081460"}, "title":{"label":"Thank you"}, "content":{"label":"I wasn’t sure how to leave a message to the guy that made this.\n\nI wanna thank you. Before I gotten this app, I would’ve guessed I was walking 7000 steps.\n\nThe reality was, I was only walking 1000.\n\nI’ve had it for about a year and a half now and push myself to walk 5000 steps.\n\n5000 is becoming normal and I’ve also joined the gym.\n\nThank you for one of the first steps.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=712286167&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
