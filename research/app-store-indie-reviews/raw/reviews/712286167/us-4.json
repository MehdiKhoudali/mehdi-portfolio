{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id37797119"}, "name":{"label":"CaptainJanks"}, "label":""}, "updated":{"label":"2026-03-27T23:36:22-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"7.2"}, "id":{"label":"13895212019"}, "title":{"label":"Too many ads to upgrade to premium."}, "content":{"label":"I've bought the no ads upgrade and happily used the app for years but the most recent update has an ad for Premium on the main screen every time I open the app. Way too aggressive and I'm not even against supporting devs who make products I like, but I have zero interest in Premium's features and seeing a big bar taking up a ton of real estate on the main page every time I open the app is just too much and kind of insulting as a person who specifically paid to not get any ads. Just because it's for your own product doesn't mean it's not an ad. 👎", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=712286167&type=Purple%20Software"}}, "im:voteSum":{"label":"3"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"3"}}, 
