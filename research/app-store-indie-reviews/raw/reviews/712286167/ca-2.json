{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id958147654"}, "name":{"label":"Argh$&@$!"}, "label":""}, "updated":{"label":"2025-03-07T13:46:44-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"6.2.5"}, "id":{"label":"12393902442"}, "title":{"label":"Liked until I discovered it’s broken"}, "content":{"label":"I really liked that I could chart my walking, until I opened the app while a passenger in a vehicle and watched as my changes in elevation and distance got turned into steps walked and floors of stairs mounted. How weird that the app doesn’t recognize that I was traveling at 100 kilometres an hour and very obviously not walking or running anywhere. With no option to manually change the wrong information and no reply to an email about this problem I’m now deleting this app.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=712286167&type=Purple%20Software"}}, "im:voteSum":{"label":"2"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"2"}}, 
