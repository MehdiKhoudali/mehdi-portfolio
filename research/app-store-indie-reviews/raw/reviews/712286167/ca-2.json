{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id118322970"}, "name":{"label":"Racerkeke"}, "label":""}, "updated":{"label":"2024-05-21T18:05:40-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"5.4.2"}, "id":{"label":"11292931374"}, "title":{"label":"Widgets don’t work AND"}, "content":{"label":"I have been a user of this app for years, and it has unfortunately gone downhill. Without changing anything in settings or route, a walk that used to be 4800 steps is now barely 4000. The widget on the Today screen does not update unless I go into the app, which makes the widget useless. The widget on the Lock Screen no longer works at all as of today.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=712286167&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
