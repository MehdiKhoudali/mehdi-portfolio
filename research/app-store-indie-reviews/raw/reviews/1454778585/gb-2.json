{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id123218876"}, "name":{"label":"zexpe"}, "label":""}, "updated":{"label":"2025-10-19T16:55:15-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"1.90.0"}, "id":{"label":"13288824249"}, "title":{"label":"Notification spam defeats app purpose"}, "content":{"label":"The whole purpose of this app is to provide reminder notifications to drink water to “boost focus” - however, the first notification I received was a promotional advert. If I want to boost focus I don’t want to be distracted by irritating promo notification spam. I can’t disable notifications because that is the entire point of the app. So I just deleted the app instead.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=1454778585&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
