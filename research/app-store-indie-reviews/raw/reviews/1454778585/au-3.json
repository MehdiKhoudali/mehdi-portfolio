{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id353040416"}, "name":{"label":"madhewton"}, "label":""}, "updated":{"label":"2024-02-04T01:46:55-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.77.0"}, "id":{"label":"10900074061"}, "title":{"label":"Really great APP!"}, "content":{"label":"I love this app. I’ve been having trouble getting much water into my day lately and have been getting very dehydrated. This app has all different types of drinks you can add in to your daily drinks tally, so also helps me keep track of my alcohol intake, and also my sugar intake if I’m drinking too many soft drinks! Highly recommend, and it’s only $9.99 for a lifetime membership - can’t beat that!!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=1454778585&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
