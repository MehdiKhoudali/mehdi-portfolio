{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id1333971196"}, "name":{"label":"Timbit4Tim"}, "label":""}, "updated":{"label":"2024-06-16T05:39:24-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"3.9"}, "id":{"label":"11387685629"}, "title":{"label":"Used to be okay"}, "content":{"label":"Most features were hidden behind a paywall, but that's fine since I just wanted a buffer wall between opening an app I knew would take a lot of time. Now the app is asking for NOTIFICATION permission through focus mode, which I turned on but it doesn't recognize. I don't understand why this app needs to send me notifications. Will be uninstalling.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=1532875441&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id385095859"}, "name":{"label":"anonymouscanadianwoman"}, "label":""}, "updated":{"label":"2024-06-15T07:12:33-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.9"}, "id":{"label":"11384261254"}, "title":{"label":"Intervention is Annoying…Perfect"}, "content":{"label":"The intervention telling me to take a deep breath is usually enough of a deterrent. I don’t even bother opening the social media apps anymore because I know that I’ll have to go through that. It’s exactly what I wanted!!! Great app, hats off to the developers! 🎩🤠", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=1532875441&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
