{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id1096536733"}, "name":{"label":"p4priv8"}, "label":""}, "updated":{"label":"2022-12-14T16:51:25-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"3.2.2"}, "id":{"label":"9396901404"}, "title":{"label":"BEWARE | CANNOT ERASE WEBSITE HISTORY"}, "content":{"label":"I recently noticed that since having the app installed you are no longer able to clear your web history or data from Safari. On top of that, all Safari extensions are greyed out and cannot be used.\n\nThis is somewhat alarming and had me panicking until I found out it was this app. \n\nPerhaps there’s a workaround… if not this has to be fixed immediately.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=1532875441&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
