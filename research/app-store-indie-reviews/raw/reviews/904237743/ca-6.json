{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id3829127"}, "name":{"label":"drwindupbird"}, "label":""}, "updated":{"label":"2017-06-05T09:21:09-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.0.2"}, "id":{"label":"1634557094"}, "title":{"label":"A beautiful, polished update!"}, "content":{"label":"It's a bit pricey, especially if you get the equally-amazing Mac app too, but so worth it if you want and need a good organizer. This is what happens when people are willing to pay for beautiful, thoughtful apps rather than \"free\" garbage.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
