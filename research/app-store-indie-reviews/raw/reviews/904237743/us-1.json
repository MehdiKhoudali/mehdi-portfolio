{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id41837116"}, "name":{"label":"Pete Sees"}, "label":""}, "updated":{"label":"2026-07-25T20:01:52-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.22.10"}, "id":{"label":"14348750223"}, "title":{"label":"Outstanding"}, "content":{"label":"I’ve been using a long in the tooth app for a long time just because it was too much trouble to migrate. AI walked through me through the process of migration and now I can use a vastly better app. No subscription fee, reasonable price. Huge thank you to the developers.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1285349650"}, "name":{"label":"CRSRPK"}, "label":""}, "updated":{"label":"2026-07-24T13:02:20-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"3.22.10"}, "id":{"label":"14343763731"}, "title":{"label":"Collaborative features"}, "content":{"label":"It would be a five-out-of-five-star rating if the developer added modern collaborative features. I’d even pay for a new version!!!\n\nThings 3 for now sits more idle and lonelier than I wish it were.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
