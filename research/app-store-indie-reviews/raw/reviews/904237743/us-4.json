{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id80016010"}, "name":{"label":"Things3Blows"}, "label":""}, "updated":{"label":"2025-05-04T10:49:58-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"3.21.16"}, "id":{"label":"12619383432"}, "title":{"label":"No “select all” feature"}, "content":{"label":"The developers refuse to add a simple “select all” feature to help you move your tasks. It’s ridiculous, and so annoying to select all tasks one by one. I have asked the developers for this simple feature, and years later they still have not added it.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
