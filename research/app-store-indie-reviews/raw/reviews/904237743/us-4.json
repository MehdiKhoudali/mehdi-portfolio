{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id472770452"}, "name":{"label":"HazedandEschewed"}, "label":""}, "updated":{"label":"2025-01-02T13:19:25-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.21.6"}, "id":{"label":"12137102167"}, "title":{"label":"Great App for Productivity"}, "content":{"label":"I love this app!!! Really helps with keeping track of things. I would love more versatility in it though. For example, I would like to be able to set a reminder for a reminder before certain due dates to keep me on task or be able to set reminders for repetitive dates, like having it notify me every week to water my plants. That would be way more helpful than having a task sit in my Today section. Thank you!!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"2"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"2"}}, 
