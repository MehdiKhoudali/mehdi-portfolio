{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id11703572"}, "name":{"label":"Steve Cochrane"}, "label":""}, "updated":{"label":"2025-01-23T19:52:18-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.21.8"}, "id":{"label":"12223393681"}, "title":{"label":"My daily to-do app since 2009"}, "content":{"label":"Things has been pretty much perfect since 2009 and it has stayed that way, which is a really special thing in this day and age. I feel like most of the software I use inevitably gets worse over time, but Cultured Code got it right from the beginning, they’ve made some nice little additions here and there and kept the design fresh, and they wisely recognized that it doesn’t need any major changes.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
