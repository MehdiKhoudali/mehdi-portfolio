{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id309680100"}, "name":{"label":"Mom with family"}, "label":""}, "updated":{"label":"2025-04-27T17:49:00-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.21.15"}, "id":{"label":"12593963435"}, "title":{"label":"Finally found it"}, "content":{"label":"As the person with many hats I have many details to take care of. This app has made me more efficient and accountable.  I honestly didn’t mind paying $10 for it.  Worth every penny for my peace of mind.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1215535432"}, "name":{"label":"notoriousLSP"}, "label":""}, "updated":{"label":"2025-04-24T20:01:12-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.21.15"}, "id":{"label":"12582803323"}, "title":{"label":"Worth it for my sanity"}, "content":{"label":"Felt a bit odd buying the iPhone and Mac versions of this app, but after using it for everything for the past several weeks (full time day job, night classes for my MBA, and personal admin), I can easily say this is the best investment in productivity software I have ever made. I love that I just pay once and I have access to such a great app. I’ll definitely be picking up the iPad version at some point to complete my integration. \n\nHuge thank you to the developers at Cultured Code!!! You all rock!!!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
