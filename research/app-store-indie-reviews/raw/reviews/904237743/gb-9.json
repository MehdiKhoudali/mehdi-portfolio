{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id114425111"}, "name":{"label":"Jogzc"}, "label":""}, "updated":{"label":"2017-05-24T14:52:38-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.0.2"}, "id":{"label":"1623211203"}, "title":{"label":"Getting better and hope for more"}, "content":{"label":"Been a keen user for Things for a couple of years now. Always hoped for a new function on the \"project\" side, which is the possibility to automatically set new completion date and start date for the tasks after a delay in previous tasks. Not sure if this is possible in Things as this is not yet a project management app...", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
