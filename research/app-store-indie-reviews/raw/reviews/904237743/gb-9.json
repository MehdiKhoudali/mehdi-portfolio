{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id178660474"}, "name":{"label":"Ritchie72"}, "label":""}, "updated":{"label":"2017-05-25T23:40:46-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.0.2"}, "id":{"label":"1624495849"}, "title":{"label":"Fantastic"}, "content":{"label":"Ive been using this app since v1 but have noticed over the last year that there were a few features that were easier to use on the desktop than on the iPhone app. This version has addressed all my minor issues and then improved everything else in such a beautiful way. Happy to pay for this upgrade. Well worth it!!!! Well done guys!!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
