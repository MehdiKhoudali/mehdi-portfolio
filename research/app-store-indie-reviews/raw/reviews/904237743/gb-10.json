{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id181010955"}, "name":{"label":"gkulkarni"}, "label":""}, "updated":{"label":"2017-05-20T05:01:11-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.0.2"}, "id":{"label":"1619131300"}, "title":{"label":"Solid, beautiful app that Just Works"}, "content":{"label":"This a great piece of software, from discerning and thoughtful developers. It works without problems and does what it promises. Get it to implement the Getting Things Done system.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
