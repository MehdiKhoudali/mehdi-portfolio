{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id24708284"}, "name":{"label":"Motley F"}, "label":""}, "updated":{"label":"2025-11-18T08:22:21-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"3.22.4"}, "id":{"label":"13413354800"}, "title":{"label":"Mac ecosystem only GRRRR"}, "content":{"label":"A little did I know that purchasing this app was just a waste of my money. There’s not even a web version, and that’s prehistoric in today’s world.\n\nThis app looks nice, but it’s useless unless you buy Mac products your entire life.\n\nNo web version? That’s absurd in 2025.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
