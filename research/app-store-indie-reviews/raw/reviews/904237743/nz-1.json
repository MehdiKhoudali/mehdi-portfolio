{"author":{"uri":{"label":"https://itunes.apple.com/nz/reviews/id486328193"}, "name":{"label":"Charlie Q NZ"}, "label":""}, "updated":{"label":"2020-10-16T12:24:06-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.13.4"}, "id":{"label":"6542189396"}, "title":{"label":"After 6 months of use.."}, "content":{"label":"Folks, the start up cost is minimal compared to the benefits and cost savings this will bring, one small detail forgotten in my industry can be VERY costly. I run it on iPhone and Ipad, works flawlessly. I work in engineering construction -design, fabricate and install. Throughout the day I generally carry a traditional paper notebook, then that info is entered into “Things 3” and everything falls into place.  Works for me 100%. Thank you to the team at Cultured Code.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/nz/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
