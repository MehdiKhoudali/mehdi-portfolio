{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id180410405"}, "name":{"label":"The Reel Noiresque"}, "label":""}, "updated":{"label":"2017-05-19T15:46:49-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"3.0.2"}, "id":{"label":"1618486507"}, "title":{"label":"Privacy"}, "content":{"label":"I've wasted money buying separate apps for my phone and iPad, assuming i. Oils sync across devices. \nBut syncing requires users to create an online account. \nI don't want to do that. We shouldn't need to do that. Dropbox? iCloud?\nI wish developers would clarify this stuff in their descriptions. \nOver twenty bucks down the drain. :(", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=904237743&type=Purple%20Software"}}, "im:voteSum":{"label":"5"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"10"}}, 
