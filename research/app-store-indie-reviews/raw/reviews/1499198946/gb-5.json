{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id117553183"}, "name":{"label":"lkucy2"}, "label":""}, "updated":{"label":"2025-02-12T05:35:24-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"4.0.1"}, "id":{"label":"12302106157"}, "title":{"label":"Full day tasks"}, "content":{"label":"Since the update, tasks are set for all day no longer show as a small icon when the day is not selected, meaning they can easily be missed. This means you have to select a random time to make them appear as an icon on weekly/monthly view, which is frustrating as this was never the case.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
