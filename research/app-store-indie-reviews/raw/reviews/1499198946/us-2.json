{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1419795962"}, "name":{"label":"Micro_Biologist"}, "label":""}, "updated":{"label":"2026-09-09T08:49:08-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"4.5.5"}, "id":{"label":"14529671531"}, "title":{"label":"Spectacular App"}, "content":{"label":"This app is just amazing. It helps me stay organized and I am more motivated to complete a task when I schedule them through this application. The amount of features available without a required payment is fantastic. Quite honestly, I am more inclined to purchase a subscription to the app when there are many features available for free. Truly wonderful app. Very well done!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"2"}}, 
