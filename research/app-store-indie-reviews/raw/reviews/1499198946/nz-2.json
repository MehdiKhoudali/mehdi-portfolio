{"author":{"uri":{"label":"https://itunes.apple.com/nz/reviews/id172254407"}, "name":{"label":"Samoanboy685"}, "label":""}, "updated":{"label":"2022-03-17T13:37:45-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2.1.5"}, "id":{"label":"8466372914"}, "title":{"label":"Amazing"}, "content":{"label":"I am currently in my final year of law school and have been looking for an app to help structure my days and keep me accountable when I tend to lose focus. This app along with all its features in the pro setting is exactly what I have been needing all these years. 100% recommend it to anyone. Thank you!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/nz/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
