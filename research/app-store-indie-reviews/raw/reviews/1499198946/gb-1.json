{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id172256154"}, "name":{"label":"Angel7uk"}, "label":""}, "updated":{"label":"2026-08-09T14:34:34-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"4.5.3"}, "id":{"label":"14408126667"}, "title":{"label":"Perfect until..."}, "content":{"label":"I really enjoyed this app and bought the upgrade because it was affordably priced, giving me 9 months of structured support to stay on track. However, after activating the AI feature, my task list exploded to an overwhelming number, so many I can’t delete them individually. I've uninstalled and reinstalled the app several times without success. Now, I'm back to testing other apps, but so far, none have matched this one 😩", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
