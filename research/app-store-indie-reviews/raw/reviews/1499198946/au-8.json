{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id220947370"}, "name":{"label":"Scraphappyjen"}, "label":""}, "updated":{"label":"2022-11-27T13:05:44-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2.6.1"}, "id":{"label":"9335932183"}, "title":{"label":"I Know Where My Time Goes"}, "content":{"label":"I love the feature in Structured that tells me how much time I have between tasks and prompts me to consider what to do with it. Being able to see how much time is actually allocated to the normal every-day tasks in my calendar and what is left over allows me to be realistic about where and how I want to use my time and energy.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
