{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id505019746"}, "name":{"label":"WatchGents.com"}, "label":""}, "updated":{"label":"2024-09-23T09:01:28-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.7.2"}, "id":{"label":"11756280386"}, "title":{"label":"The best of all, tested them all"}, "content":{"label":"The beat AI, natural language recognition, interface, clear view of the day calendar app. BUT one thing is missing. A view of the week (at least widget) AND please…. Please… an outlook integration (import and export new events and tasks to and from outlook)\n\nPlease do this integration, i only work with outlook and its a bummer when you create an event in Structured and have to create it too in outlook.\n\nStill giving a 5 star", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
