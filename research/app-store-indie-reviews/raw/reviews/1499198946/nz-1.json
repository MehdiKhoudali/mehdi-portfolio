{"author":{"uri":{"label":"https://itunes.apple.com/nz/reviews/id994289507"}, "name":{"label":"sawixo"}, "label":""}, "updated":{"label":"2024-04-07T02:58:21-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.4.2"}, "id":{"label":"11131138605"}, "title":{"label":"Great for an ADHD brain"}, "content":{"label":"Structure and routine are so important for me when managing my days, but it doesn’t come naturally to me with my ADHD. This app is amazing for repeating tasks to get into a routine, as well as other non-repeating things that pop up. I can easily see where my free time is, I can put completely customised reminders for as many or as few things as I’d like, and a million other handy little features that make it SO easy to tailor to what works for you! I have been using Structured for about 6 months and it’s amazing! Thank you for making a planner that actually works for neurodivergent people!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/nz/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
