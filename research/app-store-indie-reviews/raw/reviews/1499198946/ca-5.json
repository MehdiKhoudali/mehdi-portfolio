{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id26335007"}, "name":{"label":"SuesCasterW"}, "label":""}, "updated":{"label":"2025-02-05T10:48:49-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"4.0.1"}, "id":{"label":"12274777644"}, "title":{"label":"Still waiting for weekly view"}, "content":{"label":"New update is disappointing. I asked for a weekly view and what they gave was not it. It's just little bubbles at the top of the screen. I need to see my week all in one go, time blocked. This bubble thing not helpful for planning out the week. Even if it's only available on tablet or computer still need a weekly view. Please do better.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
