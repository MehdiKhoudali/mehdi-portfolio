{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id314237272"}, "name":{"label":"Ilovemuze"}, "label":""}, "updated":{"label":"2024-12-22T13:29:39-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.8.5"}, "id":{"label":"12094165919"}, "title":{"label":"Must have -ADHD"}, "content":{"label":"My friend sent me a TikTok about this app and immediately bought it. I’m not kidding when I say it has changed my life. My house is organized, I feel more organized and as a result, my anxiety has decreased significantly. No more running to do errands and forgetting to make a stop, forgetting to clean the litter box or missing gatherings I said yes to a month before. I look forward to new features and updates.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
