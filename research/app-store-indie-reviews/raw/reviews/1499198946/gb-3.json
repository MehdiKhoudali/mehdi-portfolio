{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id151775997"}, "name":{"label":"Erinnom"}, "label":""}, "updated":{"label":"2025-11-01T18:12:35-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"4.3.7"}, "id":{"label":"13344647004"}, "title":{"label":"This app changed my mind set"}, "content":{"label":"I am so pleased I downloaded this app. It helps me with organising myself and reducing stress and overwhelm. The visual nature of it and the flexibility is very ADHD friendly. This app has really changed the way I deal with tasks and made a huge difference to my life.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
