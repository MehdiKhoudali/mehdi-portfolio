{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id1522297729"}, "name":{"label":"Keishyhope"}, "label":""}, "updated":{"label":"2023-04-25T01:41:36-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"3.0.7"}, "id":{"label":"9858861750"}, "title":{"label":"Simple, effective & worth it!"}, "content":{"label":"As a new mom who is on maternity leave and studying full time plus being a SAHM, this has really helped me feel not overwhelmed with daily tasks. It has helped me plan my day with studying, events & tasks. I tend to download apps and never use them again after a single use, but I’ve used this consecutively! That’s the huge deal maker for me :)", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
