{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id665669076"}, "name":{"label":"AA-MCR-18"}, "label":""}, "updated":{"label":"2026-03-19T02:25:30-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"4.4.6"}, "id":{"label":"13863911617"}, "title":{"label":"Best thing for my ADHD."}, "content":{"label":"This app has changed my life, no exaggeration. I really struggled to remember when I need to do certain things. This app plans my day for me, and keeps me on track by sending me reminders of the things I have planned. Every time I plan something on this app it always happens. I wouldn’t hesitate to download this app for a second. Best app to exist.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=1499198946&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
