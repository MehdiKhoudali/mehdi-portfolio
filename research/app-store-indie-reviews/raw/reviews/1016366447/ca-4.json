{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id19195413"}, "name":{"label":"hockey_magnet"}, "label":""}, "updated":{"label":"2017-03-22T06:48:02-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.1"}, "id":{"label":"1570126546"}, "title":{"label":"Great update"}, "content":{"label":"Some really useful updates. Especially tag management and nested tags. Bear is a the best writing app I've found so far. No feature bloat yet easy to use. Devs are very responsive and this major update is promising for future development. Try the free version and see for yourself", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=1016366447&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
