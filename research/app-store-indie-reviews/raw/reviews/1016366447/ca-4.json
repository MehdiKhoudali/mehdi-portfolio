{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id262447654"}, "name":{"label":"AJC_95"}, "label":""}, "updated":{"label":"2017-05-25T17:13:20-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.2"}, "id":{"label":"1624200880"}, "title":{"label":"Bear Is Amazing"}, "content":{"label":"This apps makes me want to start writing again. I just love it, I use it all the time to jot down notes and draft blog posts. I recommend Bear to all my friends and it's not like I have to tell them, when they see me using it their automatic response is \"what app is that? It looks really cool\".\n\nKeep on keeping on Bear Team!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=1016366447&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id109436702"}, "name":{"label":"happytobeahappycustomer"}, "label":""}, "updated":{"label":"2017-05-07T15:45:51-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"1.1.2"}, "id":{"label":"1607913710"}, "title":{"label":"Subscription is a money grab"}, "content":{"label":"App's ok, but the subscription price is ridiculous.  Greedy money grab.  Grab yourself a free writing app or one that's a one-time purchase.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=1016366447&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"2"}}, 
