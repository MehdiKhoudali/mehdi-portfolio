{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id298924303"}, "name":{"label":"jacobdclemens"}, "label":""}, "updated":{"label":"2017-09-23T07:55:51-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"1.2.5"}, "id":{"label":"1805641966"}, "title":{"label":"Boo to subscription"}, "content":{"label":"This is a wonderful, simple text editor and web clipper but it shouldn’t have a subscription based sync. I’m not saying it should be free but it should have one time purchase feature over the subscription based synchronization.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=1016366447&type=Purple%20Software"}}, "im:voteSum":{"label":"25"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"45"}}, 
