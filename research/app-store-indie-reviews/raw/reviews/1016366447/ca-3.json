{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id128482628"}, "name":{"label":"ptmcgee"}, "label":""}, "updated":{"label":"2018-10-28T11:02:12-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.6.4"}, "id":{"label":"3354755899"}, "title":{"label":"Absolutely love this app!"}, "content":{"label":"Bear is my favourite note app!\n\nI have been using it for months now and it is my go-to app. I love it’s clean, simple interface. And it syncs accurately and consistently. I have no concerns about editing a note on various devices (unlike other note apps). \n\nIt also performs perfectly when I’m flying. I can edit away till my heart is content and i never have lost content. \n\nIt just works — allowing my mind to be focused on creativity!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=1016366447&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
