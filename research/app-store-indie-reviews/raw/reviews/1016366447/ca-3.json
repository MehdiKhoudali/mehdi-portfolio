{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id428950403"}, "name":{"label":"Yheojdbsilqmgek"}, "label":""}, "updated":{"label":"2018-03-25T21:44:16-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"1.4.2"}, "id":{"label":"2347296449"}, "title":{"label":"Down to Subscriptions!"}, "content":{"label":"This app is beautiful. Except the glaring ugly red and white letters that spell “subscription”. I would gladly spend 5-10 bucks for an app like this, much preferable to spend the money now than having to spend every month. In my opinion, not that I matter, the subscription should be replaced with a single sale in app purchase which gives you access to all the premium features. That would make this app perfect.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=1016366447&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
