{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id39693702"}, "name":{"label":"C.J."}, "label":""}, "updated":{"label":"2017-08-11T01:12:54-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2.5.1"}, "id":{"label":"1722734854"}, "title":{"label":"Fair Dues!"}, "content":{"label":"One of the best reminders / timer apps on the planet.\n\nI've tried most, if not all\nof them, and this probably\nwins hands down.\n\nWhy?\n\n1  Simple to set up,edit\n2  Syncs to iCloud \n3  Sweet sounds\n4  Synergy via Notifications\n5  Snooze button\n6  Swipe actions\n7  Sublime settings", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=390017969&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"2"}}, 
