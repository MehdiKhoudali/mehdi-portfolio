{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id471363426"}, "name":{"label":"rpow593"}, "label":""}, "updated":{"label":"2026-03-14T03:48:02-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"26.2"}, "id":{"label":"13846733993"}, "title":{"label":"Watch app is terrible"}, "content":{"label":"This review is mainly for the Watch app. It is so reliant on the phone you cannot even add a new reminder. Nagging alarms don’t work without the phone. I don’t always have my phone with me so the app becomes useless. It’s a real shame because the Apple Watch desperately needs a nagging reminder app that doesn’t require the phone.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=390017969&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
