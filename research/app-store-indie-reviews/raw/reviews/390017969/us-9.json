{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id184267464"}, "name":{"label":"AHCReston"}, "label":""}, "updated":{"label":"2021-12-01T18:04:21-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"21.13"}, "id":{"label":"8085280279"}, "title":{"label":"The new POST-IT!"}, "content":{"label":"I use DUE all day everyday! It has replaced my post it notes and TO DO lists. It helps me track all the tasks that would otherwise float out of my brain. I also use it to remember co workers birthdays, and even input positive affirmations to repeat daily. LOVE IT!\n\nThanks for the calendar update! No more spinning the wheel to save a note with a far date.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=390017969&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
