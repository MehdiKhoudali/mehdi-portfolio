{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id20351398"}, "name":{"label":"ToddSTS"}, "label":""}, "updated":{"label":"2021-11-29T07:20:33-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"21.13"}, "id":{"label":"8076574763"}, "title":{"label":"Awesome app! Former Android users needing a good reminder app this is it."}, "content":{"label":"When I switched to iOS from Android I kept missing reminders from google calendar due to differences in how iOS does notifications. They are simply more persistent in Android. I tried the built in Reminders app and had the same issue. Due works for me because it keeps refreshing the reminder so it stay at the top of notifications. Well worth the price to me to stop missing reminders.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=390017969&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
