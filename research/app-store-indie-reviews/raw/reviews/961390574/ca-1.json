{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id49419243"}, "name":{"label":"Patysday"}, "label":""}, "updated":{"label":"2026-02-16T18:02:34-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"6.3.3"}, "id":{"label":"13757504248"}, "title":{"label":"Think about your decisions"}, "content":{"label":"I opened the app and got asked if I’d like to pay money. I said no. Then I was asked if I’d like to listen to a song. I said no. Then I was asked if I’d like to pay money again, I said no. Finally I saw the weather for a second, but carrot made no sassy comment. While trying to figure out how to get it to speak, it once again asked if I’d like to subscribe to premium, I said no, then was hit immediately with another pop up box. Would you like to leave a review? lol sure then.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=961390574&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
