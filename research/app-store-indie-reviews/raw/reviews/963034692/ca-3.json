{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id238158958"}, "name":{"label":"NicknameForAppleItsGK"}, "label":""}, "updated":{"label":"2021-11-05T15:39:26-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"7.1.4"}, "id":{"label":"7992811619"}, "title":{"label":"Great App! Easy to Use and No Subscription"}, "content":{"label":"This app has helped me track my habits and progress! It is perhaps the best value for money for the ~10 bucks I spent for the bundle!\n\nWhat I like most:\n- No subscription here! Hate subscription apps! \n- Easy to use to and see progress in the button and calendar modes \n- Syncs with Apple health for health based tracking (one downside is you can input data for the past, but that might be a health app limitation)\n- Can export data to CSV", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
