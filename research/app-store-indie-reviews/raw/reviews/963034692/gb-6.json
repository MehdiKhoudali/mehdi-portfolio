{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id152561393"}, "name":{"label":"Josh8253"}, "label":""}, "updated":{"label":"2017-10-31T03:20:52-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"3.1.4"}, "id":{"label":"1887344984"}, "title":{"label":"Best 👏 App 👏 Ever👏"}, "content":{"label":"Truly this app has changed my life for the better. It's incredibly funny how brain-dead simple this app is, yet it serves the single core function of tracking habits so much better than other habit apps. \n\nI truly love these developers and I have my new fit body and over 2+ years of meditating everyday to thank them for. \n\nKeep up the terrific work! 👏💯🔥🙌", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
