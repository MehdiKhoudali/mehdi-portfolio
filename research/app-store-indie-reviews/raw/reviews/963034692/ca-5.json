{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id131208806"}, "name":{"label":"dasanti55"}, "label":""}, "updated":{"label":"2018-02-01T12:54:09-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"3.1.7"}, "id":{"label":"2154831140"}, "title":{"label":"So much potential but..."}, "content":{"label":"This really should be the top habit tracker in the App Store but I have multiple habits doubled up in a lot of the tasks I’ve created - 12 is NOT enough!! Also, you should be able to pick the days of the week you want to perform some of the tasks and ideally the time span you want to complete them in. I don’t want them to complicate it but these couple of fixes would make this a 5++ star review!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id87279365"}, "name":{"label":"solitudeSlicer"}, "label":""}, "updated":{"label":"2018-01-26T14:20:55-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"3.1.7"}, "id":{"label":"2130326760"}, "title":{"label":"Needs more tasks/pages"}, "content":{"label":"Would be 5 starts if I could have more than 12tasks/two pages. I want to track all my dailies. For $7 I think they could support more tasks. \nAlso, it syncs with health app and headspace, so why not Streaks Workout?", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
