{"author":{"uri":{"label":"https://itunes.apple.com/nz/reviews/id23603438"}, "name":{"label":"eatingfrogs"}, "label":""}, "updated":{"label":"2023-01-10T00:23:01-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"8.1.4"}, "id":{"label":"9491330601"}, "title":{"label":"How all apps should be."}, "content":{"label":"This is a beautifully designed app, simple to use but with a huge amount of depth if required. Want to exercise three times per week? Meditate for five minutes twice a day? Limit yourself to three drinks per week? It’s super easy to set up your tasks how you’d like, reminders how you’d like, and make changes whenever you want. And there are absolutely no ads or upsell options, no tracking. This has made my life better.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/nz/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
