{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id432503121"}, "name":{"label":"Gregy55"}, "label":""}, "updated":{"label":"2022-04-03T08:04:13-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"7.5.5"}, "id":{"label":"8527464658"}, "title":{"label":"Good app and support"}, "content":{"label":"Used this app for a few years, it was great. But when I opened the app today, everything disappeared, no streaks, no progress, just an empty landing page. I have icloud sync on, but it looks like it's not working either. The app is still handy, so I'll keep using it, it's just sad that a few years of streaks are lost.\n\nUpdate : support came back to me and there is a Settings > Manage Data > Backups page feature, so I just restored a backup.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
