{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id513386217"}, "name":{"label":"Pierre Allouez"}, "label":""}, "updated":{"label":"2025-05-29T05:54:22-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"10.4.7"}, "id":{"label":"12711520194"}, "title":{"label":"I’m a user for life"}, "content":{"label":"I’m very grateful for this app that assists me to create good habits and break bad habits. Habits are very powerful parts of our character, and the humble simplicity of this app allows YOU to shine, not it. I’m a user for life!!!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
