{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id25573261"}, "name":{"label":"Belushus"}, "label":""}, "updated":{"label":"2025-07-09T06:32:53-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"10.4.9"}, "id":{"label":"12871227227"}, "title":{"label":"A mainstay app for me"}, "content":{"label":"I got the app as a free download when Starbucks used to give out song of the week and free app downloads. It has been my go to app every time I want to motivate myself into completing something. I don’t just use for habits only", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
