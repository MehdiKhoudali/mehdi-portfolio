{"author":{"uri":{"label":"https://itunes.apple.com/ie/reviews/id384041384"}, "name":{"label":"Soairse"}, "label":""}, "updated":{"label":"2019-07-03T22:02:22-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"4.2.1"}, "id":{"label":"4408006698"}, "title":{"label":"Pointless for me anyway"}, "content":{"label":"Unclear data after three days showed 100 percent for last 30 days despite missing the 2nd day!  Most of the goals are common sense that people shouldn’t obsess over anyway. You don’t need your phone to tell you you haven’t eaten a healthy meal.\nI find the activity app excellent and all I need.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ie/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
