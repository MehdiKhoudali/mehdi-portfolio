{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id117313364"}, "name":{"label":"teegs36"}, "label":""}, "updated":{"label":"2023-10-08T00:33:13-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"9.3.5"}, "id":{"label":"10451316703"}, "title":{"label":"Not worth it"}, "content":{"label":"I got 8 notifications over the span of 30 minutes…. Can only have 6 tasks on a page. The layout is ok, overall design could be better. There’s not much to it, you’d probably be better off looking for another app, don’t think it’s worth the money", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
