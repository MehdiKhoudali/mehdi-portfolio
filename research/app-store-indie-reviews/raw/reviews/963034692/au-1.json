{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id746869178"}, "name":{"label":"kjfrncs"}, "label":""}, "updated":{"label":"2023-04-16T20:49:03-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"9.0.3"}, "id":{"label":"9830347848"}, "title":{"label":"Watch consistently does not hold the task completion"}, "content":{"label":"Love the app. Love the idea. BUT hate that I bought this app for my Apple Watch and consistently I will complete a task on my watch and moments later the app says it hasn’t been done. And then I complete it again and immediately after it registers it being doe. It’s reset to not done. \nPlease fix this bug!!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
