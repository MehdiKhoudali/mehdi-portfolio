{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id384896053"}, "name":{"label":"Morganna187494"}, "label":""}, "updated":{"label":"2023-09-19T22:55:18-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"9.3.1"}, "id":{"label":"10386986461"}, "title":{"label":"Great customer support"}, "content":{"label":"I lost all my data after updating my phone - very sad! I contacted support team by email and they were very quick to respond with a helpful solution to retrieve my data. I can now happily continue streaking (😂) App itself is great. High level of customisation available if wanted but you can also get by with the basics just fine if that’s your preference.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
