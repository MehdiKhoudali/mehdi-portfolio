{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id145419568"}, "name":{"label":"Karlemilkoch"}, "label":""}, "updated":{"label":"2016-07-22T11:41:11-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.7.4"}, "id":{"label":"1417723798"}, "title":{"label":"Great way to complete mini tasks"}, "content":{"label":"I love using Streaks alongside a more comprehensive task manager to keep me on task with the simple things like hitting 10 flights of stairs a day or doing at least 40 minutes of exercise. Wouldn't be without it now. And... It offers a brilliant Apple Watch app. Can't wait for the watchOS 3 update!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
