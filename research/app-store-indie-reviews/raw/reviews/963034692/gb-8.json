{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id85223821"}, "name":{"label":"TheKnower69"}, "label":""}, "updated":{"label":"2016-09-13T23:32:16-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"2.0"}, "id":{"label":"1449405688"}, "title":{"label":"New update destroys app"}, "content":{"label":"The developers have disabled the ability to retrospectively mark days as complete. \n\nI am devastated because I had several long standing streaks which I cannot update correctly now. \n\nWhat a disappointment and I really liked the app before they did this. \n\nWhy change something that works?", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
