{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id33340931"}, "name":{"label":"Nick Moore (@pilotmoon)"}, "label":""}, "updated":{"label":"2016-09-16T23:36:24-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"2.0"}, "id":{"label":"1451032122"}, "title":{"label":"Best of the bunch"}, "content":{"label":"I downloaded a large number of streak tracking apps. This was the one I liked best. It is simple and clean. Health app integration is nice, but a bit of a gimmick. The new multiple step completion goals are awesome. At its core this app is well designed and, importantly, feels satisfying to use. I have used it for about two months and formed some good regular habits.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
