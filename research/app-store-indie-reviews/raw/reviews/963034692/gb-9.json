{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id85483898"}, "name":{"label":"Beaglebrains"}, "label":""}, "updated":{"label":"2016-02-02T00:57:37-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.6.1"}, "id":{"label":"1326501444"}, "title":{"label":"Love it so far!"}, "content":{"label":"Only been using it a few days, but I can see it's going to be really useful in keeping on track with swapping some of my old 'bad' habits for new ones! Love the fact you can set them for a certain number of days per week without having to specify exact days.\nHere's to lots of 100% streaks!!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=963034692&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
