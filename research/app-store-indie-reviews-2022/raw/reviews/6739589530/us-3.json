{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1285327931"}, "name":{"label":"Exoskeleton.com"}, "label":""}, "updated":{"label":"2025-03-26T13:54:15-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.0.2"}, "id":{"label":"12468013773"}, "title":{"label":"Actually works"}, "content":{"label":"This is the only screen time reducer that has really worked for me. I’ve been going outside more, reading more, talking to people more, and watching TikTok less. It’s sounds like an exaggeration, it sounds too good to be true, but it is. Literally the best screen time control app, I highly recommend.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=6739589530&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
