{"author":{"uri":{"label":"https://itunes.apple.com/ca/reviews/id276853982"}, "name":{"label":"1.2.3.4,5.6.6"}, "label":""}, "updated":{"label":"2026-07-15T17:10:17-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"1.4.2"}, "id":{"label":"14308130502"}, "title":{"label":"Must have app"}, "content":{"label":"This app works very well. My screen time has dropped by half. I work in a concrete jungle, so I use the breathing break instead. So glad they added that feature, since grass is hard to come by at work. But I wish they would add the ability to ignore some apps. Since things like using maps for gps, workout apps, meditation apps, etc… count towards my screen time. I’ll be driving somewhere using my gps and get a notification that I need a break from my phone. Other then that though, it works great and does its job well.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ca/review?id=6739589530&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
