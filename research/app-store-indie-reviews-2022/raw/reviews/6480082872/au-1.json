{"author":{"uri":{"label":"https://itunes.apple.com/au/reviews/id29240334"}, "name":{"label":"ooblackrabbitoo"}, "label":""}, "updated":{"label":"2024-09-24T03:27:09-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.7.0"}, "id":{"label":"11758792518"}, "title":{"label":"My phone is not engaging"}, "content":{"label":"This app is simple.\nAnd thats what i want my phone to be.\n\n1) delete all your apps from the home screen\n2) limit all your widgets from your home screen\n3) choose a theme... black or white\n4) list and link your main apps\n5) enjoy the wprld arohnd you, youll stop engaging with  your phone.\n\nHint. Want black and white weather widget get 'boring weather' fits with the theme.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/au/review?id=6480082872&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
