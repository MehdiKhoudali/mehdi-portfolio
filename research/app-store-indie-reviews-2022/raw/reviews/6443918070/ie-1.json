{"author":{"uri":{"label":"https://itunes.apple.com/ie/reviews/id1536685443"}, "name":{"label":"Paubery"}, "label":""}, "updated":{"label":"2025-12-11T08:23:21-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.14.3"}, "id":{"label":"13501632975"}, "title":{"label":"Best intuitive tracker app"}, "content":{"label":"A very to the point and intuitive app to track any habits you may want to track!\nDid I read a book today? Check\nDid I go to the gym today? Check\nDid I order food today? Check\nEtc… \n\nIt can be as simple or as complex and you want!\n\nHighly recommended!\n\nThe dev is responsive and rolling out update following the end user feedback!\n\n5 stars", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/ie/review?id=6443918070&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
