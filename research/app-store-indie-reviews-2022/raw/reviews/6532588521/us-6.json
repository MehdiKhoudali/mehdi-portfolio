{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id732167999"}, "name":{"label":"wocketandpocket"}, "label":""}, "updated":{"label":"2026-02-18T22:28:34-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"177"}, "id":{"label":"13765144040"}, "title":{"label":"Why?????"}, "content":{"label":"I’ve been on the app for no less than 2 weeks paid for the annual membership. Now every-time I log in I’m being forced to click get started on some stupid therapy thing that I DONT WANT! It won’t let me get off it. Deleted the app now my account is gone…. NEVER AGAIN #LessonLearned", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=6532588521&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
