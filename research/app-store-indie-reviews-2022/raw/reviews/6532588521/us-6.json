{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id491762910"}, "name":{"label":"lookoutfordetox"}, "label":""}, "updated":{"label":"2026-02-19T08:58:13-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"177"}, "id":{"label":"13766744285"}, "title":{"label":"Useless now"}, "content":{"label":"Had no problems until Wednesday. There’s this baked in ad for “betterhelp” that has no button to close, just a promo code and link to sign up. Only “work around” is clicking the check up notification when it shows, but then the ad pops right back up. Can’t do anything on this app now, other users already reported this happening and still no fix EVEN THOUGH there was an update yesterday which did nothing to fix this", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=6532588521&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
