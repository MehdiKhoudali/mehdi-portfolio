{"author":{"uri":{"label":"https://itunes.apple.com/br/reviews/id1573321725"}, "name":{"label":"Deny.D"}, "label":""}, "updated":{"label":"2025-10-28T21:21:13-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"1.0.20"}, "id":{"label":"13327865998"}, "title":{"label":"Muito bugado"}, "content":{"label":"Dependendo de quantos vídeos coloca, o app simplesmente trava no meio do tanto de vídeo q você colocou e fica por isso msm, a questão de ter que pagar para jogar os outros modos tbm é uma coisa ridícula, Plmns põe pra assistir anúncio para liberar o modo ou coisa do tipo. Ter de pagar para jogar é apenas ridículo.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/br/review?id=6742410648&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Aplicativo"}}, "im:voteCount":{"label":"0"}}, 
