{"author":{"uri":{"label":"https://itunes.apple.com/gb/reviews/id1753285046"}, "name":{"label":"Nikifor16"}, "label":""}, "updated":{"label":"2025-02-08T01:40:38-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"4.16.0"}, "id":{"label":"12285188573"}, "title":{"label":"Great app for couples"}, "content":{"label":"My girlfriend and I downloaded this app after seeing it on social media and instantly loved it! The topics are great conversation starters and it’s always a nice way to start a cute discussion about that time when either of you did something funny! Recommend this app to couples in both long distance and living together circumstances as either way it is a great way to talk about things you otherwise might not!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/gb/review?id=1624758651&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
