{"author":{"uri":{"label":"https://itunes.apple.com/de/reviews/id540041162"}, "name":{"label":"Philip_0203"}, "label":""}, "updated":{"label":"2026-08-23T02:31:46-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"4.28.0"}, "id":{"label":"14461914292"}, "title":{"label":"Sehr gute App"}, "content":{"label":"Couple Joy ist eine sehr gute und abwechslungsreiche App die wirklich viel Spaß bereitet.\n\nEs wäre schön, wenn die Themen auch mal mit neuen Fragen oder neuen Themen aktualisiert werden. Ansonsten kann ich es für jedes Paar empfehlen", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/de/review?id=1624758651&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Programm"}}, "im:voteCount":{"label":"0"}}, 
