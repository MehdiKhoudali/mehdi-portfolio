{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id217539555"}, "name":{"label":"AlwaysInTheStars"}, "label":""}, "updated":{"label":"2026-04-02T09:44:44-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"4.25.0"}, "id":{"label":"13914876818"}, "title":{"label":"Even the free version is great!"}, "content":{"label":"I downloaded this app for me and my boyfriend. We live over an hour apart and each have very busy lives. I had a feeling my boyfriend would love this app because he’s a romantic, and I was 100% right. We actually both ended up loving it though. You can add memories with photos, play games, save special dates, and more. While there are “intimate” sections, the questions can be modified to not be 18+ depending on your comfort level. My favorite part is the map that lets you see all the spots you’ve visited together! Highly recommend this app.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1624758651&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
