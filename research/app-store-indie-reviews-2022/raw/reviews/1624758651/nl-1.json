{"author":{"uri":{"label":"https://itunes.apple.com/nl/reviews/id664802302"}, "name":{"label":"T.NTHX"}, "label":""}, "updated":{"label":"2025-01-21T08:56:59-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"4.15.1"}, "id":{"label":"12212375112"}, "title":{"label":"AMAZING APP FOR COUPLES"}, "content":{"label":"Amazing App for Couples!\nCouple Joy is such a fantastic app! It’s beautifully designed, easy to use, and has helped my partner and me grow even closer. The activities and prompts are super fun, meaningful, and encourage deep conversations we hadn’t had before.\n\nThe app makes it so easy to connect on a deeper level and keep the spark alive in our relationship. I highly recommend it to any couple looking to strengthen their bond or simply spend more quality time together. Love it!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/nl/review?id=1624758651&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Applicatie"}}, "im:voteCount":{"label":"0"}}, 
