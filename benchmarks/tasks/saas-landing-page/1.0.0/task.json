{
  "id": "saas-landing-page",
  "version": "1.0.0",
  "title": "SaaS landing page from a detailed brief",
  "brief": "brief.md",
  "starter": "starter",
  "setupCommands": [
    ["npm", "ci", "--ignore-scripts"]
  ],
  "acceptanceCommands": [
    ["npm", "run", "build"],
    ["npm", "run", "verify"]
  ],
  "protectedPaths": [
    "AGENTS.md",
    "BRIEF.md",
    "package.json",
    "package-lock.json"
  ],
  "limits": {
    "timeoutMinutes": 30,
    "commandTimeoutMinutes": 10,
    "reasoningEffort": "medium"
  }
}
