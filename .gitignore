# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# local benchmark runs and generated task artifacts
/benchmarks/.runs/
/benchmarks/results/*
!/benchmarks/results/.gitkeep
/benchmarks/tasks/**/starter/node_modules/
/benchmarks/tasks/**/starter/dist/

# Local Netlify folder
.netlify
